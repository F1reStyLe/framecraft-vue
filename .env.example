VITE_API_BASE_URL=/api
VITE_AUTH_API_BASE_URL=/auth-api

# Vite proxy targets. The defaults below are for running npm locally.
VITE_API_PROXY_TARGET=http://localhost:8180
VITE_AUTH_API_PROXY_TARGET=http://localhost:8080

# Direct backend URL is also supported if backend CORS allows it:
# VITE_API_BASE_URL=http://localhost:8180
# VITE_AUTH_API_BASE_URL=http://localhost:8080
